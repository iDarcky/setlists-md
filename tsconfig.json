{
  // TypeScript covers the NEW chart only (src/features/chart-v2, 2026-11-18).
  // The rest of the app stays JavaScript until after 1 Feb 2027; JS files are
  // readable from TS (allowJs) but not type-checked (checkJs: false).
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "baseUrl": ".",
    "paths": { "@/*": ["src/*"] },
    "types": ["vite/client"]
  },
  "include": ["src/features/chart-v2/**/*", "src/types/**/*"]
}
