{
  // TypeScript covers the NEW chart (src/features/chart-v2, 2026-11-18) and
  // the NEW first-run screens (src/features/intro, 2026-11-20). The rest of the
  // app stays JavaScript; JS files are readable from TS (allowJs) but not
  // type-checked (checkJs: false).
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "baseUrl": ".",
    "paths": { "@/*": ["src/*"] },
    "types": ["vite/client"]
  },
  "include": ["src/features/chart-v2/**/*", "src/features/intro/**/*", "src/types/**/*", "src/ui/typed.ts", "src/ui/shadcn/create-button.tsx", "src/features/songs/**/*.ts", "src/features/songs/**/*.tsx", "src/features/song-edit/**/*.ts", "src/features/song-edit/**/*.tsx", "src/features/song/**/*.ts", "src/features/song/**/*.tsx"]
}
